-- LocalScript TEST Shadow + Troll Mechanic (spawn vào CurrentRoom -> Table hoặc KeyHitbox)

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- load shadow asset
local shadowAsset = game:GetObjects("rbxassetid://11631916882")[1]
if not shadowAsset then
    warn("Không load được shadow asset")
    return
end

-- Helpers để tìm CurrentRoom dựa trên attribute player:GetAttribute("CurrentRoom")
local function findRoomByIndex(index)
    if not index then return nil end
    -- thử nhiều heuristic: attribute trên model, tên chứa index, hoặc tên có "Room"
    for _, m in ipairs(workspace:GetDescendants()) do
        if m:IsA("Model") then
            local attrs = {
                m:GetAttribute("RoomIndex"),
                m:GetAttribute("Index"),
                m:GetAttribute("RoomNumber"),
                m:GetAttribute("RoomId")
            }
            for _, a in ipairs(attrs) do
                if a and tostring(a) == tostring(index) then
                    return m
                end
            end
            -- tên chứa index (ví dụ "Room 2", "Room_2")
            if tostring(m.Name):lower():find(tostring(index)) then
                -- chắc chắn đây là room hơn (tránh match quá rộng) - kiểm tra có child door hoặc walls
                if m:FindFirstChildWhichIsA("BasePart", true) then
                    return m
                end
            end
        end
    end

    -- fallback: tìm "CurrentRooms" container (Doors thường có) rồi lấy room with attribute Index
    local containers = {"CurrentRooms", "Rooms", "Map"}
    for _, name in ipairs(containers) do
        local cont = workspace:FindFirstChild(name)
        if cont and cont:IsA("Model") or cont:IsA("Folder") then
            for _, r in ipairs(cont:GetChildren()) do
                if r:IsA("Model") then
                    local attrs = {
                        r:GetAttribute("RoomIndex"),
                        r:GetAttribute("Index"),
                        r:GetAttribute("RoomNumber"),
                        r:GetAttribute("RoomId")
                    }
                    for _, a in ipairs(attrs) do
                        if a and tostring(a) == tostring(index) then
                            return r
                        end
                    end
                end
            end
        end
    end

    return nil
end

-- tìm Table trong room (ưu tiên tên "Table", nếu không thì các từ khóa gần nghĩa)
local function findTableInRoom(room)
    if not room then return nil end
    local keywords = {"table", "desk", "counter", "stand", "nightstand", "side", "dining"}

    -- 1) tìm chính xác "Table"
    for _, desc in ipairs(room:GetDescendants()) do
        if desc:IsA("Model") and tostring(desc.Name):lower() == "table" then
            return desc
        end
        if desc:IsA("BasePart") and tostring(desc.Name):lower() == "table" then
            return desc
        end
    end

    -- 2) tìm chứa từ khóa
    for _, kw in ipairs(keywords) do
        for _, desc in ipairs(room:GetDescendants()) do
            if (desc:IsA("Model") or desc:IsA("BasePart")) and tostring(desc.Name):lower():find(kw) then
                return desc
            end
        end
    end

    return nil
end

-- tìm keyhitbox trong room
local function findKeyHitboxInRoom(room)
    if not room then return nil end
    for _, obj in ipairs(room:GetDescendants()) do
        if obj:IsA("BasePart") and tostring(obj.Name):lower() == "keyhitbox" then
            return obj
        end
    end
    return nil
end

-- nếu không tìm thấy room, fallback tìm toàn workspace
local function findAnyKeyHitbox()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and tostring(obj.Name):lower() == "keyhitbox" then
            return obj
        end
    end
    return nil
end

-- spawn shadow with smarter placement
local function spawnShadow()
    local currentRoomIndex = player:GetAttribute("CurrentRoom")
    local room = findRoomByIndex(currentRoomIndex)

    -- Try to find table/keyhitbox in room (or fallback)
    local tableObj = room and findTableInRoom(room) or nil
    local keyhitbox = room and findKeyHitboxInRoom(room) or nil

    if not tableObj and not keyhitbox then
        -- fallback to global keyhitbox search
        keyhitbox = findAnyKeyHitbox()
    end

    if not tableObj and not keyhitbox then
        warn("Không tìm thấy Table hoặc KeyHitbox để spawn Shadow")
        return
    end

    -- random chọn spawn trên Table hoặc KeyHitbox nếu cả hai có
    local prefer = nil
    if tableObj and keyhitbox then
        prefer = (math.random(1,2) == 1) and "table" or "keyhitbox"
    elseif tableObj then
        prefer = "table"
    else
        prefer = "keyhitbox"
    end

    local spawnCFrame = nil

    if prefer == "table" and tableObj then
        -- lấy basepart của table (nếu tableObj là BasePart thì dùng trực tiếp)
        local basePart = nil
        if tableObj:IsA("BasePart") then
            basePart = tableObj
        elseif tableObj:IsA("Model") then
            basePart = tableObj:FindFirstChildWhichIsA("BasePart", true)
        end

        if basePart then
            -- set vị trí spawn ở phía trước theo yêu cầu: basePart.CFrame * CFrame.new(0,0,-size.Z/2)
            local offset = Vector3.new(0, 0, -(basePart.Size.Z / 2))
            spawnCFrame = basePart.CFrame * CFrame.new(offset)
        else
            -- fallback: nếu model table không có basepart, dùng model.PrimaryPart nếu có
            if tableObj.PrimaryPart then
                local offset = Vector3.new(0, 0, -(tableObj.PrimaryPart.Size.Z / 2))
                spawnCFrame = tableObj.PrimaryPart.CFrame * CFrame.new(offset)
            else
                -- fallback to tableObj:GetModelCFrame()
                warn("Table tìm thấy nhưng không có BasePart -> sẽ spawn tại vị trí trung tâm model")
                local center = tableObj:GetModelCFrame and tableObj:GetModelCFrame() or (tableObj.PrimaryPart and tableObj.PrimaryPart.CFrame or nil)
                spawnCFrame = center or CFrame.new(tableObj:GetBoundingBox() and tableObj:GetBoundingBox().CFrame.Position or tableObj:GetModelCFrame())
            end
        end
    end

    if (not spawnCFrame) and keyhitbox then
        spawnCFrame = CFrame.new(keyhitbox.Position)
    end

    if not spawnCFrame then
        warn("Không thể tính được spawnCFrame")
        return
    end

    -- clone shadow và đặt
    local shadow = shadowAsset:Clone()
    shadow.Parent = workspace

    local handle = shadow:FindFirstChild("Handle", true)
        or shadow:FindFirstChildWhichIsA("BasePart", true)

    if not handle then
        warn("Shadow không có Handle/BasePart")
        shadow:Destroy()
        return
    end

    if not shadow.PrimaryPart then
        shadow.PrimaryPart = handle
    end

    -- Set PrimaryPartCFrame theo spawnCFrame
    shadow:SetPrimaryPartCFrame(spawnCFrame)

    for _, p in ipairs(shadow:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored = true
            p.CanCollide = false
        end
    end

    -- trạng thái troll
    local usedOnce = false
    local exploded = false

    -- tạo prompt trên handle
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Take"
    prompt.ObjectText = "Shadow"
    prompt.MaxActivationDistance = 5
    prompt.HoldDuration = 3
    prompt.RequiresLineOfSight = false
    prompt.Parent = handle

    prompt.Triggered:Connect(function(plr)
        if plr ~= player or exploded then return end

        -- LẦN ĐẦU
        if not usedOnce then
            usedOnce = true
            print("Shadow: lần đầu...")

            -- hiệu ứng nhẹ
            pcall(function()
                TweenService:Create(handle, TweenInfo.new(0.2), {
                    Transparency = 0.2
                }):Play()
            end)

            -- chạy cruc (call external script safe)
            pcall(function()
                loadstring(game:HttpGet(
                    "https://raw.githubusercontent.com/eoyoustme/back/refs/heads/main/cruc"
                ))()
            end)

            return
        end

        -- LẦN THỨ HAI = CHẾT
        exploded = true
        print("Shadow: tham lam rồi 😈")

        -- rung camera nhẹ
        local cam = workspace.CurrentCamera
        local oldCF = cam.CFrame
        task.spawn(function()
            for i = 1, 8 do
                cam.CFrame = oldCF * CFrame.new(
                    math.random(-2,2)/10,
                    math.random(-2,2)/10,
                    0
                )
                task.wait(0.03)
            end
            cam.CFrame = oldCF
        end)

        -- hiệu ứng nổ
        for _, p in ipairs(shadow:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Anchored = true
                p.CanCollide = false
                pcall(function()
                    TweenService:Create(p, TweenInfo.new(0.3), {
                        Transparency = 1,
                        Size = p.Size * 2
                    }):Play()
                end)
            end
        end

        task.wait(0.15)

        -- CHẾT NGAY
        humanoid.Health = 0

        task.delay(1, function()
            if shadow then shadow:Destroy() end
        end)
    end)
end

-- BẤM B ĐỂ TEST
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.B then
        spawnShadow()
    end
end)

print("[TEST] Press B to spawn Shadow (TROLL ENABLED) - spawns in CurrentRoom (Table or KeyHitbox)")
