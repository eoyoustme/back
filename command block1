--== TẠO MODEL DREADCLOCK ==--
local room = workspace.CurrentRooms[game.ReplicatedStorage.GameData.LatestRoom.Value]

local omg = Instance.new("Model")
omg.Name = "DreadClock"
omg.Parent = room

--== LẤY MODEL EYES ==--
local eyes = game:GetObjects("rbxassetid://135459928966068")[1]
eyes.Parent = omg

--== TÌM GIỮA PHÒNG ==
local centerCFrame

if room:FindFirstChild("PathfindNodes") then
    local nodes = room.PathfindNodes:GetChildren()
    table.sort(nodes, function(a,b) return tonumber(a.Name) < tonumber(b.Name) end)

    local midIndex = math.floor(#nodes / 2)
    if midIndex < 1 then midIndex = 1 end

    centerCFrame = nodes[midIndex].CFrame
else
    local mainPart = room:FindFirstChild(room.Name)
    if mainPart then
        centerCFrame = mainPart.CFrame
    else
        warn("Không tìm được vị trí giữa phòng!")
        return
    end
end

--== ĐẶT EYES Ở GIỮA PHÒNG ==
eyes:PivotTo(centerCFrame + Vector3.new(0, 5, 0))


--== FIX PROXIMITY PROMPT KHÔNG HOẠT ĐỘNG ==--
local smoothBlockModel = omg:FindFirstChild("Smooth Block Model")

local targetPart

-- TÌM PART BÊN TRONG MODEL
if smoothBlockModel then
    for _, v in ipairs(smoothBlockModel:GetChildren()) do
        if v:IsA("BasePart") then
            targetPart = v
            break
        end
    end
end

-- NẾU KHÔNG CÓ → fallback
if not targetPart then
    targetPart = eyes.PrimaryPart
end

--== TẠO PROMPT ĐÚNG CÁCH ==--
local prompt = Instance.new("ProximityPrompt")
prompt.ActionText = "Collect"
prompt.ObjectText = "Strange Device"
prompt.HoldDuration = 4
prompt.RequiresLineOfSight = false
prompt.Parent = targetPart  -- ⚠ MUST BE A PART


--== KHI HOÀN THÀNH PROMPT ==--
prompt.Triggered:Connect(function(player)

    local pick = math.random(1, 2)

    if pick == 1 then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/eoyoustme/back/refs/heads/main/Crucifix"))()
        require(player.PlayerGui.MainUI.Initiator.Main_Game)
            .caption("Command block is give you crucifix", true)
    else
        loadstring(game:HttpGet("https://raw.githubusercontent.com/eoyoustme/Monoxide/refs/heads/main/Flashlight"))()
        require(player.PlayerGui.MainUI.Initiator.Main_Game)
            .caption("command block is give you flashlight", true)
    end

    omg:Destroy()
end)

