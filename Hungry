local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local soundId = 9125712561
local soundDuration = 14

-- Lấy cửa hiện tại
local function getCurrentDoor()
    local room = workspace.CurrentRooms[RS.GameData.LatestRoom.Value]
    if room and room:FindFirstChild("Door") then
        return room.Door
    end
    return nil
end

local door = getCurrentDoor()
if not door then warn("Không tìm thấy cửa!") return end

-- Chặn mở cửa
local prompt = door:FindFirstChild("Door"):FindFirstChildWhichIsA("ProximityPrompt")
if prompt then
    prompt.Enabled = false
end

-- PHÁT ÂM THANH
local sound = Instance.new("Sound")
sound.SoundId = "rbxassetid://" .. soundId
sound.Volume = 6
sound.Parent = workspace
sound:Play()

-- Khi âm thanh xong + 14s → cho mở cửa
task.spawn(function()
    sound.Ended:Wait()
    task.wait(soundDuration)

    if prompt then
        prompt.Enabled = true
    end
end)
