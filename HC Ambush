entity:SetCallback("OnDamagePlayer", function(newHealth)
    if newHealth == 0 then
        print("Entity has killed the player")
		local RunService = game:GetService("RunService")
		local TweenService = game:GetService("TweenService")
		local Players = game:GetService("Players")
		local player = Players.LocalPlayer

		-- Cấu hình
		local TOGGLES = 1.5       -- số lần chuyển (kết thúc ở size 400 và play sound)
		local WAIT_BETWEEN = 0.6        -- mỗi bước chờ 1 giây
		local FINAL_TWEEN_DURATION = 35 -- thời gian tween scale lớn (giữ như bạn trước)
		local FINAL_SIZE = UDim2.new(0, 1300000, 0, 1300000)

		-- Tạo sound (không play ngay)
		local sound = Instance.new("Sound", workspace)
		sound.SoundId = "rbxassetid://18532501108"
		sound.TimePosition = 0
		local level = Instance.new("DistortionSoundEffect", sound)
		level.Level = 0.4

		wait(0.2)
		sound:Play()

		-- Tạo GUI
		local screen = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))

		local background = Instance.new("Frame", screen)
		background.AnchorPoint = Vector2.new(0.5, 0.5)
		background.Size = UDim2.new(10, 0, 10, 0)
		background.Position = UDim2.new(0.5, 0, 0.5, 0)
		background.BackgroundColor3 = Color3.fromRGB(0, 0, 0)

		local image = Instance.new("ImageLabel", screen)
		image.AnchorPoint = Vector2.new(0.5, 0.5)
		image.Position = UDim2.new(0.5, 0, 0.5, 0)
		image.BackgroundTransparency = 1
		image.Size = UDim2.new(0, 5, 0, 5) -- BẮT ĐẦU ở 0,100,0,100
		image.LayoutOrder = 0
		image.BorderSizePixel = 0
		image.Image = "http://www.roblox.com/asset/?id=12557955051"
		image.Rotation = 0

		-- flash màu background
		task.spawn(function()
			while background and background.Parent do
				background.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				task.wait(0.08)
				if not background or not background.Parent then break end
				background.BackgroundColor3 = Color3.fromRGB(85, 255, 0)
				task.wait(0.08)
			end
		end)

		-- ===== oscillation (rotation + jitter) =====
		local ROT_AMPLITUDE = 6
		local PERIOD = 0.1
		local JITTER_X = 7
		local JITTER_Y = 7

		local t0 = tick()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			if not image or not image.Parent then
				if conn then conn:Disconnect() end
				return
			end
			local elapsed = tick() - t0
			local s = math.sin(2 * math.pi * elapsed / PERIOD)
			image.Rotation = ROT_AMPLITUDE * s
			-- dùng tần số nhân để chuyển động nhanh hơn/không đồng bộ
			local offsetX = math.sin(5 * math.pi * elapsed / (PERIOD * 1.3)) * JITTER_X
			local offsetY = math.cos(5 * math.pi * elapsed / (PERIOD * 1.1)) * JITTER_Y
			image.Position = UDim2.new(0.5, offsetX, 0.5, offsetY)
		end)
		-- ==========================================

		-- Sequence: alternation giữa size 100 và 400 mỗi 1 giây, kết thúc ở 400
		local function runSizeSequence(targetImage, toggles, waitTime)
			if not targetImage or not targetImage.Parent then return end
			-- đảm bảo bắt đầu ở 100 (đã set phía trên)
			for i = 1, toggles do
				-- set trực tiếp sang 400 (không tween)
				targetImage.Size = UDim2.new(0, 300, 0, 300)
				-- nếu đây là lần cuối thì break sau chờ 1s để play sound + tween
				if i == toggles then
					task.wait(waitTime)
					break
				end
				-- nếu chưa phải lần cuối, chờ 1s rồi về 100, tiếp vòng
				task.wait(waitTime)
				if not targetImage or not targetImage.Parent then return end
				targetImage.Size = UDim2.new(0, 100, 0, 100)
				task.wait(waitTime)
			end
		end

		-- Chạy sequence (kết thúc ở size 400), rồi play sound và tween lớn
		runSizeSequence(image, TOGGLES, WAIT_BETWEEN)
		image.Image ="http://www.roblox.com/asset/?id=12557955051"

		-- Khi đã xong sequence: play sound rồi tween scale lớn
		if sound and sound.Parent then
			pcall(function() end)
		end

		local bigTween = TweenService:Create(image, TweenInfo.new(FINAL_TWEEN_DURATION, Enum.EasingStyle.Linear), {Size = FINAL_SIZE})
		bigTween:Play()

		-- Cleanup: nếu bạn muốn giữ tween chạy lâu thì tăng thời gian chờ ở dưới hoặc xóa cleanup
		-- Mình chờ 1.5s (giống code trước) rồi destroy UI + sound + disconnect conn
		task.wait(1)
		if sound then pcall(function() sound:Destroy() end) end
		if screen then pcall(function() screen:Destroy() end) end
		if conn then pcall(function() conn:Disconnect() end) end

		-- =================================================================

		-- Nếu bạn vẫn muốn destroy giống code gốc: (hiện bạn xóa sau 1 giây)
		task.wait(0.7)
		if sound then sound:Destroy() end
		if screen then screen:Destroy() end
		if conn then
			pcall(function() conn:Disconnect() end)
    else
        print("Entity has damaged the player")
    end
end)

