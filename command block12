--== TẠO MODEL DREADCLOCK ==--
local room = workspace.CurrentRooms[game.ReplicatedStorage.GameData.LatestRoom.Value]

local omg = Instance.new("Model")
omg.Name = "DreadClock"
omg.Parent = room

--== LẤY MODEL EYES ==--
local eyes = game:GetObjects("rbxassetid://135459928966068")[1]
eyes.Parent = omg

--== ĐẢM BẢO EYES CÓ PRIMARYPART ==--
if not eyes.PrimaryPart then
    -- Tự động set PrimaryPart bằng BasePart đầu tiên
    for _, v in ipairs(eyes:GetChildren()) do
        if v:IsA("BasePart") then
            eyes.PrimaryPart = v
            break
        end
    end
end

if not eyes.PrimaryPart then
    warn("Eyes không có BasePart!")
    return
end


--== TÌM GIỮA PHÒNG ==
local centerCFrame

if room:FindFirstChild("PathfindNodes") then
    local nodes = room.PathfindNodes:GetChildren()
    table.sort(nodes, function(a,b) return tonumber(a.Name) < tonumber(b.Name) end)

    local midIndex = math.floor(#nodes / 2)
    centerCFrame = nodes[midIndex].CFrame
else
    centerCFrame = room:FindFirstChild(room.Name).CFrame
end

--== ĐẶT EYES Ở GIỮA PHÒNG ==
eyes:PivotTo(centerCFrame + Vector3.new(0, 5, 0))


--== TÌM PART CHO PROMPT (KHÔNG BAO GIỜ DÙNG MODEL) ==--
local smoothModel = omg:FindFirstChild("Smooth Block Model")
local partForPrompt

if smoothModel then
    for _, v in ipairs(smoothModel:GetChildren()) do
        if v:IsA("BasePart") then
            partForPrompt = v
            break
        end
    end
end

-- fallback dùng primary part của eyes
if not partForPrompt then
    partForPrompt = eyes.PrimaryPart
end


--== TẠO PROMPT (Giờ chắc chắn gắn vào BasePart) ==--
local prompt = Instance.new("ProximityPrompt")
prompt.ActionText = "Collect"
prompt.ObjectText = "Strange Device"
prompt.HoldDuration = 4
prompt.RequiresLineOfSight = false
prompt.MaxActivationDistance = 12
prompt.Parent = partForPrompt


--== SỰ KIỆN KHI NHẶT XONG ==--
prompt.Triggered:Connect(function(player)
    local pick = math.random(1, 2)

    if pick == 1 then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/eoyoustme/back/refs/heads/main/Crucifix"))()
        require(player.PlayerGui.MainUI.Initiator.Main_Game)
            .caption("Command block is give you crucifix", true)
    else
        loadstring(game:HttpGet("https://raw.githubusercontent.com/eoyoustme/Monoxide/refs/heads/main/Flashlight"))()
        require(player.PlayerGui.MainUI.Initiator.Main_Game)
            .caption("command block is give you flashlight", true)
    end

    omg:Destroy()
end)
