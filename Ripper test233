entity.Debug.OnEntityDamagedPlayer = function(player)
    
    print("Entity gây sát thương – bắt đầu jumpscare!")

    task.spawn(function()

        --------------------------------------------------
        -- == LẤY NHÂN VẬT / ENTITY == --
        --------------------------------------------------
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local TweenService = game:GetService("TweenService")

        local plr = Players.LocalPlayer
        local char = plr.Character or plr.CharacterAdded:Wait()
        local humanoid = char:WaitForChild("Humanoid")
        local root = char:WaitForChild("HumanoidRootPart")

        local entityModel = workspace:FindFirstChild("RipperMovings")
        if not entityModel then return end

        local function SetAllParticlesTimeScale(model, t)
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("ParticleEmitter") then d.TimeScale = t end
            end
        end

        SetAllParticlesTimeScale(entityModel, 1)

        local main = entityModel:FindFirstChild("Ripe")
        entityModel.PrimaryPart = main
        main.Anchored = true

        --------------------------------------------------
        -- == CAMERA LOOK LOCK == --
        --------------------------------------------------
        local cam = workspace.CurrentCamera
        cam.CameraType = Enum.CameraType.Scriptable

        local camCon
        camCon = RunService.RenderStepped:Connect(function()
            if main and main.Parent then
                cam.CFrame = CFrame.lookAt(cam.CFrame.Position, main.Position)
            else
                camCon:Disconnect()
            end
        end)

        --------------------------------------------------
        -- == ENTITY TIẾN LẠI GẦN NGƯỜI CHƠI == --
        --------------------------------------------------
        local target = root.Position - root.CFrame.LookVector * -6
        TweenService:Create(main, TweenInfo.new(0.3), {CFrame = CFrame.new(target)}):Play()
        task.wait(0.3)

        TweenService:Create(main, TweenInfo.new(99999999999), {CFrame = root.CFrame}):Play()
        SetAllParticlesTimeScale(entityModel, 0)

        --------------------------------------------------
        -- == UI JUMPSCARE == --
        --------------------------------------------------
        local screenGui = Instance.new("ScreenGui", plr.PlayerGui)
        screenGui.DisplayOrder = 999999

        local image = Instance.new("ImageLabel", screenGui)
        image.Size = UDim2.new(1,0,1,0)
        image.BackgroundTransparency = 1
        image.ImageTransparency = 1

        local img1 = "rbxassetid://94547864377343"
        local img2 = "rbxassetid://236542974"

        TweenService:Create(image, TweenInfo.new(1), {ImageTransparency = 0}):Play()
        image.Image = img1

        local t = tick()
        while tick() - t < 1.4 do
            image.Image = img1
            task.wait()
            image.Image = img2
            task.wait()
        end
        
        image.ImageTransparency = 1

        --------------------------------------------------
        -- == ÂM THANH JUMPSCARE == --
        --------------------------------------------------
        local function GetSound(url, name)
            if not isfile(name..".mp3") then writefile(name..".mp3", game:HttpGet(url)) end
            local s = Instance.new("Sound")
            s.SoundId = getsynasset(name..".mp3")
            return s
        end

        local snd = GetSound("https://github.com/eoyoustme/back/raw/main/Kill_with_static.mp3", "Kill")
        snd.Parent = workspace
        snd.Volume = 1
        snd:Play()

        --------------------------------------------------
        humanoid.Health = 0
        cam.CameraType = Enum.CameraType.Custom
    end)
end


