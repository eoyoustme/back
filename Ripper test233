entity.Debug.OnEntityDespawned = function(model)

    camShake:Start()
    camShake:ShakeOnce(10, 15, 0, 5.5, 1, 0)
    camShake:Shake(CameraShaker.Presets.Earthquake)

    workspace.CurrentRooms[game.ReplicatedStorage.GameData.LatestRoom.Value].Door.ClientOpen:FireServer()

    for _, v in pairs(workspace:WaitForChild("RipperMovings"):GetDescendants()) do
        if v:IsA("Sound") then v:Destroy() end
    end

    TweenService:Create(colorEffect, TweenInfo.new(10), {
        TintColor = Color3.fromRGB(255, 255, 255),
        Saturation = 0,
        Contrast = 0
    }):Play()

    Debris:AddItem(colorEffect, 10)

    if get then
        local function GitAud(url, name)
            writefile(name..".mp3", game:HttpGet(url))
            return (getcustomasset or getsynasset)(name..".mp3")
        end

        local sound = Instance.new("Sound", workspace)
        sound.SoundId = GitAud("https://github.com/Darker-TheDarkestGuy/DOORS/raw/refs/heads/main/.mp3?raw=true", "DoorBreaker")
        sound.Volume = 1
        sound:Play()

        camShake:Start()
        camShake:ShakeOnce(20, 5, 5, 3, 2, 1)

        local badge = loadstring(game:HttpGet("https://raw.githubusercontent.com/Idk-lol2/a-60aa/refs/heads/main/fix%20bage.txt"))()
        badge({
            Title = "Torn Apart",
            Desc = "Don't Leave Too Early.",
            Reason = "Encounter Ripper",
            Image = "rbxassetid://"
        })
    end
end


