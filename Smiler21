-- Hàm kiểm tra một sound có thuộc Smiler không (ngoại lệ)
local function isSmilerSound(sound)
	for _, v in ipairs(smilerSounds) do
		if v == sound then
			return true
		end
	end
	return false
end

-- 🔥 LẤY TẤT CẢ ÂM THANH TRONG MAP (TRỪ SMILER)
local function getAllOtherSounds()
	local list = {}

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Sound") then
			if not isSmilerSound(obj) then
				table.insert(list, obj)
			end
		end
	end

	return list
end


-- 🎧 ÁP DỤNG NHIỄU ÂM THANH CHO TẤT CẢ SOUND (TRỪ SMILER)
local function applySoundGlitch(strength)
	for _, s in ipairs(getAllOtherSounds()) do
		if s.Playing then
			s.PlaybackSpeed = 0.3 + (strength * 0.2) -- càng gần càng méo
		end
	end
end

-- 🔊 Reset lại tốc độ âm thanh bình thường
local function resetAllOtherSounds()
	for _, s in ipairs(getAllOtherSounds()) do
		s.PlaybackSpeed = 1
	end
end

-- 🔊 Giữ cố định toàn bộ âm thanh Smiler = 0.3 tốc độ
local function enforceSmilerSoundSpeed()
	for _, s in ipairs(smilerSounds) do
		if s then
			s.PlaybackSpeed = 0.3
		end
	end
end


-- Tắt hiệu ứng hoàn toàn
local function disableEffect()
	cc.Enabled = false
	cc.Contrast = 0

	blur.Enabled = false
	blur.Size = 0

	noise.ImageTransparency = 1

	resetAllOtherSounds()
	enforceSmilerSoundSpeed()
end


-- Cập nhật hiệu ứng khi đến gần
local function updateEffect(distance)
	if distance > 90 then
		disableEffect()
		return
	end

	cc.Enabled = true
	blur.Enabled = true

	local alpha = math.clamp(1 - (distance / 90), 0, 1)
	noise.ImageTransparency = 1 - alpha

	applySoundGlitch(alpha)
	enforceSmilerSoundSpeed() -- Smiler giữ tốc độ 0.3 luôn

	if distance <= 50 then
		cc.Contrast = 1
		blur.Size = 68
	elseif distance <= 60 then
		cc.Contrast = 0.7
		blur.Size = 40
	elseif distance <= 90 then
		cc.Contrast = 0.5
		blur.Size = 20
	else
		cc.Contrast = 0.3
		blur.Size = 12
	end
end

-- Loop kiểm tra khoảng cách
game:GetService("RunService").RenderStepped:Connect(function()
	local char = player.Character
	if not char then return end

	-- 🔥 Nếu đang trốn → tắt sạch hiệu ứng và âm thanh
	if char:GetAttribute("Hiding") == true then
		disableEffect()
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or not smiler then return end

	local distance = (root.Position - smiler.Position).Magnitude
	updateEffect(distance)
end)

end)

