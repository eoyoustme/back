----------------------------------------------------
-- CALLBACKS
----------------------------------------------------
entity:SetCallback("OnSpawned", function()
	print("[ENTITY] Spawned")

	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://134020218579308"
	s.Volume = 5
	s.Parent = workspace
	s:Play()
end)

entity:SetCallback("OnStartMoving", function()
	print("[ENTITY] Started moving")
end)

