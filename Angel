entity:SetCallback("OnSpawned", function()
	print("Cease đã xuất hiện")
require(game.Players.LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game).caption("DON'T MOVE", true)

wait(3)

	-- === BẮT ĐẦU KIỂM TRA DI CHUYỂN CHUẨN XÁC === --
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

repeat task.wait() until entity.Model
local ceaseModel = entity.Model

-- Phạm vi Cease có thể jumpscare
local detectRange = 120 -- có thể chỉnh theo ý bạn

-- Lưu trạng thái jumpscare để không spam
local scaredPlayers = {}

RunService.Heartbeat:Connect(function()
	local ceasePos = ceaseModel:GetPivot().Position

	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local humanoid = char:FindFirstChild("Humanoid")

			if hrp and humanoid then
				local distance = (hrp.Position - ceasePos).Magnitude

				-- Trong phạm vi
				if distance <= detectRange then

					-- Kiểm tra di chuyển
					local isMovingByInput = humanoid.MoveDirection.Magnitude > 0.1
					local isMovingByVelocity = hrp.AssemblyLinearVelocity.Magnitude > 2

					if isMovingByInput and isMovingByVelocity then

						if not scaredPlayers[player] then
							scaredPlayers[player] = true

							-- 🔥 CHẠY JUMPSCARE
							task.spawn(function()
								loadstring(game:HttpGet("https://raw.githubusercontent.com/eoyoustme/back/refs/heads/main/Jumpscare123"))()
							end)
						end
					end

				else
					-- Reset khi ra khỏi phạm vi
					scaredPlayers[player] = nil
				end
			end
		end
	end
end)
