-- Hiệu ứng glitch dùng ColorCorrection + Blur
local Lighting = game:GetService("Lighting")

local cc = Instance.new("ColorCorrectionEffect", Lighting)
cc.Enabled = false
cc.Contrast = 0
cc.Saturation = 0

local blur = Instance.new("BlurEffect", Lighting)
blur.Size = 0
blur.Enabled = false

-- Hàm tắt hiệu ứng hoàn toàn
local function disableEffect()
	cc.Enabled = false
	cc.Contrast = 0
	blur.Enabled = false
	blur.Size = 0
end

-- Hàm cập nhật hiệu ứng theo khoảng cách
local function updateEffect(distance)
	if distance > 80 then
		disableEffect()
		return
	end

	cc.Enabled = true
	blur.Enabled = true

	if distance <= 30 then
		cc.Contrast = 0.9
		blur.Size = 45
	elseif distance <= 40 then
		cc.Contrast = 0.7
		blur.Size = 30
	elseif distance <= 50 then
		cc.Contrast = 0.5
		blur.Size = 20
	else
		cc.Contrast = 0.3
		blur.Size = 12
	end
end

-- Loop kiểm tra khoảng cách
game:GetService("RunService").RenderStepped:Connect(function()
	local char = player.Character
	if not char then return end

	-- 🔥 Nếu đang trốn → tắt hiệu ứng và return
	if char:GetAttribute("Hiding") == true then
		disableEffect()
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or not smiler then return end

	local distance = (root.Position - smiler.Position).Magnitude
	updateEffect(distance)
end)

end)

